# Backend Environment Variables
# Copy this file to .env and fill in actual values

# PostgreSQL Database
DATABASE_URL="postgresql://intelli_user:intelli_pass@localhost:5432/intelli_factory"

# Email Verification
VERIFY_EMAIL_BASE_URL="http://localhost:3000/verify-email"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_TLS=true
BREVO_API_KEY=""

# API Configuration
API_PORT=8000
API_ENV=development

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,localhost"

# Algorithm Parameters
POPULATION_SIZE=50
GENERATIONS=50
MUTATION_RATE=0.2
CROSSOVER_RATE=0.7
TOURNAMENT_SIZE=3

# Objective Weights (must sum to 1.0)
WEIGHT_COST=0.50
WEIGHT_SPEED=0.30
WEIGHT_RELIABILITY=0.20
