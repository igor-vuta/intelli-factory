COMPOSE_PROJECT_NAME=intelli-factory-testing
APP_DOMAIN=intelli-factory.duckdns.org
FRONTEND_PORT=4200
# Use a URL-safe random password, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=
# Set a unique release tag before deployment for rollback.
IMAGE_TAG=local
# Gmail address: use the same value for FROM and USERNAME.
SMTP_FROM_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Google app password, not your normal account password.
SMTP_PASSWORD=
